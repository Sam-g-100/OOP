
class Complex:
    # Default constructor
    def __init__(self, real=0, imag=0):
        self.real = real
        self.imag = imag

    # Overload + operator
    def __add__(self, c2):
        return Complex(
            self.real + c2.real,
            self.imag + c2.imag
        )

    # Overload * operator
    def __mul__(self, c2):
        return Complex(
            (self.real * c2.real) - (self.imag * c2.imag),
            (self.real * c2.imag) + (self.imag * c2.real)
        )

    # Overload << equivalent for printing
    def __str__(self):
        return f"{self.real}+{self.imag}i"


# Main program
c1 = Complex()
c2 = Complex()
c3 = Complex()

while True:
